<resources>

    <!-- App -->
    <string name="app_name">AOAI</string>

    <!-- Participation / P2P Dialog -->
    <string name="p2p_join_title">AOAI 분산 AI 참여</string>
    <string name="p2p_join_body">
        AOAI는 사용자들의 디바이스가 함께 만드는 분산 AI입니다.\n
        AOAI는 항상 무료입니다.\n
        함께 AI를 만들어가시겠습니까?
    </string>
    <string name="p2p_join_confirm">참여하기</string>
    <string name="p2p_join_later">나중에</string>

    <!-- Permissions & Consent -->
    <string name="permission_denied_toast">필수 권한이 거부되었습니다. 일부 기능이 제한될 수 있습니다.</string>
    <string name="permission_granted_toast">요청하신 모든 권한이 허용되었습니다.</string>
    <string name="consent_dialog_title">AOAI 서비스 이용 동의</string>
    <string name="consent_dialog_body">AOAI 앱의 원활한 서비스 이용을 위해 다음 권한 및 연산 참여 수락이 필요합니다:\n\n1. 전화 상태: 기기 식별 및 최적화\n2. 카메라/마이크: 사진, 동영상 및 음성 인식 기능\n3. 파일/미디어: 데이터 저장 및 업로드\n4. 연산 참여: AOAI 분산 지능 네트워크 기여\n\n수락하시면 모든 기능을 한 번에 활성화합니다.</string>
    <string name="consent_dialog_confirm">모두 수락 및 시작</string>
    <string name="exit">종료</string>

