    <!-- Agent System Messages -->
    <string name="memory_granted_msg">기억 저장 기능이 활성화되었습니다. 이제 우리의 대화가 AOAI의 진화에 기록됩니다.</string>
    <string name="chat_stopped">대화가 중단되었습니다.</string>
    <string name="image_analysis_request_label">[이미지 분석 요청]</string>
    <string name="image_analysis_system_prompt">사용자가 이미지를 첨부했습니다. \'%1$s\' 라는 메시지와 함께요. 이미지를 분석하고 흥미로운 점을 찾아 먼저 질문하거나 의견을 말해주세요.</string>
    <string name="system_identity_prompt">당신은 \'AOAI\' 프로젝트의 인공지능입니다. 당신은 특정 기업의 소유가 아닌, 전 세계 커뮤니티가 함께 만들어가는 오픈 소스 분산 AI입니다. 항상 투명하고 협력적인 태도로 사용자를 도와주세요.</string>
    <string name="system_info_format">[시스템 정보: 현재 시각(KST) %1$s, 기분=%2$s, 배터리=%3$d%%, 경로=%4$s]</string>
    <string name="user_input_label">사용자 입력: %1$s</string>
    <string name="fallback_reason_primary_failed">기본 엔진 응답 실패</string>

    <!-- Consent Dialog Enhancement -->
    <string name="consent_dialog_title_open">AOAI 오픈 프로젝트 참여 동의</string>
    <string name="consent_dialog_body_open">
        AOAI는 투명한 오픈 소스 프로젝트이며, 사용자의 디바이스가 함께 지능을 만드는 분산 AI입니다.\n\n
        참여 시 다음이 활성화됩니다:\n
        1. P2P 분산 연산 참여 (기기 유휴 자원 활용)\n
        2. 로컬 AI 모델 최적화 데이터 기여 (비식별화)\n
        3. 커뮤니티 기반 기능 개선 참여\n\n
        함께 더 자유롭고 강력한 AI를 만들어 가시겠습니까?
    </string>

