<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aoai.chat">

    <!-- 🌐 인터넷 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 📡 네트워크 상태 확인 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 📶 WiFi 상태 확인 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 📷 QR 스캔용 카메라 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ✅ Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- ✅ Android 14+ : dataSync 타입 사용 시 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- ✅ Android 13+ 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AOAIApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_round"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AOAI"

    <!-- ✅ 개발/내부망 테스트용: HTTP 허용 -->
    android:usesCleartextTraffic="true"

    <!-- ✅ 특정 도메인만 허용하려면 아래 XML도 유지 -->
    android:networkSecurityConfig="@xml/network_security_config">

    <!-- ✅ Foreground Service: 참여(노드) 유지 -->
    <service
        android:name=".p2p.NodeForegroundService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />

    <!-- QR 스캔 Activity -->
    <activity
        android:name=".ui.QRScanActivity"
        android:screenOrientation="portrait"
        android:exported="false" />

    <!-- 내부 WebView -->
    <activity
        android:name=".ui.WebViewActivity"
        android:exported="false" />

    <!-- ✅ 런처 Activity -->
    <activity
        android:name=".MainActivity"
        android:exported="true">

        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

    </activity>

</application>

    </manifest>